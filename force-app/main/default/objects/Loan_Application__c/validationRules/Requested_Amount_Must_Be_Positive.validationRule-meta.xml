<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Requested_Amount_Must_Be_Positive</fullName>
    <active>true</active>
    <description>Requested amount must be greater than zero.</description>
    <errorConditionFormula>Requested_Amount__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Requested_Amount__c</errorDisplayField>
    <errorMessage>Requested amount must be greater than zero.</errorMessage>
</ValidationRule>
