<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Requested_Term_In_Range</fullName>
    <active>true</active>
    <description
  >Requested term, when entered, must be 1 to 360 months.</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Requested_Term_Months__c)),
    OR(Requested_Term_Months__c &lt; 1, Requested_Term_Months__c &gt; 360)
)</errorConditionFormula>
    <errorDisplayField>Requested_Term_Months__c</errorDisplayField>
    <errorMessage
  >Requested term must be between 1 and 360 months.</errorMessage>
</ValidationRule>
