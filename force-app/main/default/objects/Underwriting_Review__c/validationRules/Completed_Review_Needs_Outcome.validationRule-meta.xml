<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_Review_Needs_Outcome</fullName>
    <active>true</active>
    <description
  >A completed review must record its outcome and when it was completed.</description>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, "Completed"),
    OR(ISBLANK(TEXT(Recommendation__c)), ISBLANK(TEXT(Risk_Rating__c)), ISBLANK(Completed_Date__c))
)</errorConditionFormula>
    <errorDisplayField>Recommendation__c</errorDisplayField>
    <errorMessage
  >A completed review needs a recommendation, risk rating, and completed date.</errorMessage>
</ValidationRule>
