<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Signed_Date_Required_When_Signed</fullName>
    <active>true</active>
    <description>A signed guarantee must record when it was signed.</description>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, "Signed"),
    ISBLANK(Signed_Date__c)
)</errorConditionFormula>
    <errorDisplayField>Signed_Date__c</errorDisplayField>
    <errorMessage>Enter the signed date for a signed guarantee.</errorMessage>
</ValidationRule>
