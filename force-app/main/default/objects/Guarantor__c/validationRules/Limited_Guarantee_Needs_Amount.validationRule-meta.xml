<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Limited_Guarantee_Needs_Amount</fullName>
    <active>true</active>
    <description>A limited guarantee must state its cap.</description>
    <errorConditionFormula>AND(
    ISPICKVAL(Coverage__c, "Limited"),
    OR(ISBLANK(Guaranteed_Amount__c), Guaranteed_Amount__c &lt;= 0)
)</errorConditionFormula>
    <errorDisplayField>Guaranteed_Amount__c</errorDisplayField>
    <errorMessage
  >Enter a guaranteed amount greater than zero for a limited guarantee.</errorMessage>
</ValidationRule>
