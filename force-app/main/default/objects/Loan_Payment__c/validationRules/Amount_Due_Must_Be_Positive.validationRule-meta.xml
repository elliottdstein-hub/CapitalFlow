<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Amount_Due_Must_Be_Positive</fullName>
    <active>true</active>
    <description>Amount due must be greater than zero.</description>
    <errorConditionFormula>Amount_Due__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Amount_Due__c</errorDisplayField>
    <errorMessage>Amount due must be greater than zero.</errorMessage>
</ValidationRule>
