<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valuation_Date_Not_Future</fullName>
    <active>true</active>
    <description>A valuation can only be dated today or earlier.</description>
    <errorConditionFormula
  >Valuation_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Valuation_Date__c</errorDisplayField>
    <errorMessage>Valuation date can't be in the future.</errorMessage>
</ValidationRule>
