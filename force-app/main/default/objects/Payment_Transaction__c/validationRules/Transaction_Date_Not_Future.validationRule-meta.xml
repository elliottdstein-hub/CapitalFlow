<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Transaction_Date_Not_Future</fullName>
    <active>true</active>
    <description
  >Money can only be recorded as received today or earlier.</description>
    <errorConditionFormula
  >Transaction_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Transaction_Date__c</errorDisplayField>
    <errorMessage>Transaction date can't be in the future.</errorMessage>
</ValidationRule>
