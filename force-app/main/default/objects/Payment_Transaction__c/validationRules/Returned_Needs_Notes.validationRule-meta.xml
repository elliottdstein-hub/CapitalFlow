<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Returned_Needs_Notes</fullName>
    <active>true</active>
    <description>A returned payment must say why.</description>
    <errorConditionFormula
  >AND(ISPICKVAL(Status__c, "Returned"), ISBLANK(Notes__c))</errorConditionFormula>
    <errorDisplayField>Notes__c</errorDisplayField>
    <errorMessage>Explain why the payment was returned.</errorMessage>
</ValidationRule>
