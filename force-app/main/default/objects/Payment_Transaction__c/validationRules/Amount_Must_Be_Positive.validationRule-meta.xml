<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Amount_Must_Be_Positive</fullName>
    <active>true</active>
    <description>Amount is required and must be above zero.</description>
    <errorConditionFormula
  >OR(ISBLANK(Amount__c), Amount__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Amount__c</errorDisplayField>
    <errorMessage>Enter a amount greater than zero.</errorMessage>
</ValidationRule>
