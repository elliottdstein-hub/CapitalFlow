<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Paid_Needs_Paid_Date</fullName>
    <active>true</active>
    <description>A paid fee must record when it was paid.</description>
    <errorConditionFormula
  >AND(ISPICKVAL(Status__c, "Paid"), ISBLANK(Paid_Date__c))</errorConditionFormula>
    <errorDisplayField>Paid_Date__c</errorDisplayField>
    <errorMessage>Enter the paid date for a paid fee.</errorMessage>
</ValidationRule>
