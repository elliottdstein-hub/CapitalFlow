<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Term_In_Range</fullName>
    <active>true</active>
    <description>Term must be 1 to 360 months.</description>
    <errorConditionFormula
  >OR(Term_Months__c &lt; 1, Term_Months__c &gt; 360)</errorConditionFormula>
    <errorDisplayField>Term_Months__c</errorDisplayField>
    <errorMessage>Term must be between 1 and 360 months.</errorMessage>
</ValidationRule>
