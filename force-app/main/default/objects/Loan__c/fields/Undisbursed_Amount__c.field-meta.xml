<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Undisbursed_Amount__c</fullName>
    <description
  >Principal amount not yet disbursed. For a line of credit, this is the limit minus completed draws, ignoring repayments.</description>
    <externalId>false</externalId>
    <formula>Principal_Amount__c - Total_Disbursed__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Undisbursed Amount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
    <unique>false</unique>
</CustomField>
