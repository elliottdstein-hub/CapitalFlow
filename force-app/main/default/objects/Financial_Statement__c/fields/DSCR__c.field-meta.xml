<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DSCR__c</fullName>
    <description
  >Debt service coverage ratio: EBITDA divided by annual debt service. Blank when debt service is not entered. Annualize EBITDA mentally for partial periods.</description>
    <externalId>false</externalId>
    <formula
  >IF(Annual_Debt_Service__c &gt; 0, EBITDA__c / Annual_Debt_Service__c, NULL)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>DSCR</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
